# ==============================================================================
# NoSQL RAG Research — Environment Configuration Template
# Copy this file to .env and fill in your actual endpoints and credentials.
# NEVER commit .env to version control.
# ==============================================================================

# Redis (Key-Value)
REDIS_URL=redis://localhost:6379/0

# MongoDB (Document)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=nosql_rag_research

# Apache Cassandra (Wide-Column)
# Mode: 'standard' (self-hosted / Docker / OCI) or 'astra' (DataStax Astra DB Serverless)
CASSANDRA_MODE=standard

# Standard mode settings
CASSANDRA_HOSTS=127.0.0.1
CASSANDRA_PORT=9042
CASSANDRA_USERNAME=
CASSANDRA_PASSWORD=
CASSANDRA_KEYSPACE=nosql_rag_research
CASSANDRA_SSL=false

# Astra DB Serverless mode settings (when CASSANDRA_MODE=astra)
# Canonical runtime location for secure-connect-bundle.zip (keep outside repo, never commit)
CASSANDRA_SECURE_CONNECT_BUNDLE_PATH=/tmp/astra_scb/secure-connect-bundle.zip
# Astra application token generated from Astra Portal (AstraCS:...)
CASSANDRA_APPLICATION_TOKEN=

# Neo4j (Graph)
NEO4J_URI=bolt://localhost:7687
# Use NEO4J_USERNAME as canonical; NEO4J_USER is supported as a fallback alias
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# Qdrant (Vector)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Experiment Deployment Metadata
DATABASE_HOSTING_REGION=local
DATABASE_DEPLOYMENT_NOTES=Local Docker / development machine
